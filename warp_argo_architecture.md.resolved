      <div class="muted" style="font-weight: 600">日志 / 原因</div>
      <textarea class="textarea" readonly :value="releaseStatusNode.last_release_message || '-'" style="min-height: 200px" />
    </template>
    <div v-else class="muted">暂无回执</div>
