  memory_usage_percent: number | null
  heartbeat_reported_at: string | null
  applied_template_ids: string[]
  target_artifact: {
    id: string
    rev: number
    engine: string
    engines: string[]
    action_sing_box: string
    action_xray: string
    reload_cmd: string
    sha256: string
